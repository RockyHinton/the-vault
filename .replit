# Replit workspace and deployment configuration for The Vault.
#
# This file carries no application configuration: the app is configured
# entirely by environment variables (see REPLIT_DEPLOYMENT.md and
# .env.example) so the same build runs on any Node + PostgreSQL + object
# storage host.
#
# The deployment TYPE is not set here. Replit's current configuration format
# has no supported Reserved VM value for `deployment.deploymentTarget`, and the
# type is chosen in the Publishing tool under "Adjust settings" →
# "Deployment type". Choose **Reserved VM** for The Vault: rate limits are
# in-memory per process, the pg pool is per process, and one company's
# instance has no need of horizontal scaling.

modules = ["nodejs-20", "web", "postgresql-16"]

# Workspace development: one command serves the API and the Vite client.
run = "npm run dev"

hidden = [".git", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
# Chromium is here for the Playwright suite (npm run test:e2e).
packages = ["chromium"]

[env]
# The server reads PORT from the environment and binds 0.0.0.0.
PORT = "5000"

# One public web port: the Express process serves both the API and the client.
[[ports]]
localPort = 5000
externalPort = 80

[deployment]
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]
