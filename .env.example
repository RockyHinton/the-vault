# Local development configuration. Copy to `.env.local` (git-ignored) and fill in.
# Only the server reads this file, and only outside production. Variables already
# present in the environment always win, so Replit/CI settings override the file.

# PostgreSQL connection for local development (see docs/development/local-setup.md for the Docker command).
DATABASE_URL=postgres://vault:change-me@localhost:5432/vault_dev

# Local HTTP port. Replit sets PORT=5000 itself; macOS reserves 5000, so 5001 locally.
PORT=5001

# Hostnames this deployment serves, comma-separated and bare (no scheme). Required in
# production (Replit deployments may rely on REPLIT_DOMAINS instead). Locally, loopback is
# always allowed; list any extra development hostnames here.
# VAULT_ALLOWED_HOSTS=vault.example.com

# File storage. `local` keeps bytes under an ignored directory; production must set the
# provider explicitly (`replit` once that adapter ships, or `local` on a persistent volume).
VAULT_STORAGE_PROVIDER=local
VAULT_STORAGE_LOCAL_DIR=.vault-data/files
# VAULT_MAX_UPLOAD_BYTES=52428800

# First-admin bootstrap, used only by `npm run bootstrap:admin`. Remove the
# password line after the first successful run. Never set these on a web server.
# VAULT_BOOTSTRAP_ADMIN_EMAIL=you@example.com
# VAULT_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
# VAULT_BOOTSTRAP_ADMIN_NAME=Your Name
