# Local development configuration. Copy to `.env.local` (git-ignored) and fill in.
# Only the server reads this file, and only outside production. Variables already
# present in the environment always win, so Replit/CI settings override the file.

# PostgreSQL connection for local development (see DEVELOPMENT.md for the Docker command).
DATABASE_URL=postgres://vault:change-me@localhost:5432/vault_dev

# Clerk development instance keys. `npx clerk@latest env pull` writes these two.
# The server accepts VITE_CLERK_PUBLISHABLE_KEY as its publishable key, so no duplicate is needed.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Local HTTP port. Replit sets PORT=5000 itself; macOS reserves 5000, so 5001 locally.
PORT=5001

# First-admin bootstrap: your own Clerk user ID (user_...). Sign in once; the
# "Access not yet granted" screen shows it. Set it, restart, sign in again, then remove it.
# VAULT_BOOTSTRAP_ADMIN_CLERK_ID=user_replace_me
